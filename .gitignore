profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the Python version is individual.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're writing something where it shouldn't be locked, uncomment the next line:
#Pipfile.lock

# uv
#   Similar to Pipfile.lock, it is generally recommended to include uv.lock in version control.
#   Uncomment if you need to ignore it:
#uv.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   Uncomment if you need to ignore it:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#   Uncomment if you need to ignore it:
#pdm.lock

# PEP 582 project packages
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

